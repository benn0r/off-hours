    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off-hours liest deinen Feiertags- und Arbeitskalender, um deine freien Tage und Bereitschaften zu kennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Off-hours reads your holiday and work calendars to know your days off and on-call shifts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off-hours lee tus calendarios de festivos y de trabajo para conocer tus días libres y guardias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off-hours lit vos calendriers des jours fériés et professionnel pour connaître vos congés et vos astreintes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off-hours legge i tuoi calendari delle festività e di lavoro per conoscere i giorni liberi e i turni di reperibilità."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Off-hours leest je feestdagen- en werkagenda om je vrije dagen en piketdiensten te kennen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Off-hours lê seus calendários de feriados e de trabalho para saber suas folgas e plantões."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Off-hours lê os seus calendários de feriados e de trabalho para conhecer as suas folgas e turnos de prevenção."
          }
        }
      }
    }

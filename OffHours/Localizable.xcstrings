    "Optional. Events whose title contains one of the keywords below become on-call shifts or days off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Termine, deren Titel eines der Stichwörter unten enthält, werden zu Bereitschaften oder freien Tagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Los eventos cuyo título contiene una de las palabras clave de abajo se convierten en guardias o días libres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Les événements dont le titre contient l'un des mots-clés ci-dessous deviennent des astreintes ou des congés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Gli eventi il cui titolo contiene una delle parole chiave qui sotto diventano turni di reperibilità o giorni liberi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Afspraken met een van de onderstaande trefwoorden in de titel worden piketdiensten of vrije dagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Eventos cujo título contém uma das palavras-chave abaixo viram plantões ou folgas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Os eventos cujo título contém uma das palavras-chave abaixo passam a turnos de prevenção ou folgas."
          }
        }
      }
    },
    "Optional. Every day with an event in this calendar counts as a day off, e.g. a public holidays calendar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Jeder Tag mit einem Termin in diesem Kalender gilt als freier Tag, z. B. ein Feiertagskalender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Cada día con un evento en este calendario cuenta como día libre, p. ej. un calendario de festivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Chaque jour avec un événement dans ce calendrier compte comme congé, p. ex. un calendrier des jours fériés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Ogni giorno con un evento in questo calendario conta come giorno libero, ad es. un calendario delle festività."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Elke dag met een afspraak in deze agenda telt als vrije dag, bijv. een feestdagenagenda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Cada dia com um evento neste calendário conta como folga, ex.: um calendário de feriados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Cada dia com um evento neste calendário conta como folga, p. ex. um calendário de feriados."
          }
        }
      }
    },

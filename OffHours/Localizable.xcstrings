    "Calendar access was denied. Enable it in Settings › Privacy & Security › Calendars." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til kalendere blev afvist. Slå det til i Indstillinger › Anonymitet & sikkerhed › Kalendere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kalenderzugriff wurde abgelehnt. Aktiviere ihn unter Einstellungen › Datenschutz & Sicherheit › Kalender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el acceso a los calendarios. Actívalo en Ajustes › Privacidad y seguridad › Calendarios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalentereiden käyttö estettiin. Salli se kohdassa Asetukset › Tietosuoja ja suojaus › Kalenterit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès aux calendriers a été refusé. Activez-le dans Réglages › Confidentialité et sécurité › Calendriers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso ai calendari è stato negato. Attivalo in Impostazioni › Privacy e sicurezza › Calendari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーへのアクセスが拒否されました。「設定」›「プライバシーとセキュリティ」›「カレンダー」で許可してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgang til kalendere ble avvist. Slå det på i Innstillinger › Personvern og sikkerhet › Kalendere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot agenda's is geweigerd. Schakel het in via Instellingen › Privacy en beveiliging › Agenda's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmówiono dostępu do kalendarzy. Włącz go w Ustawienia › Prywatność i ochrona › Kalendarze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso aos calendários foi negado. Ative-o em Ajustes › Privacidade e Segurança › Calendários."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso aos calendários foi recusado. Ative-o em Definições › Privacidade e segurança › Calendários."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst till kalendrar nekades. Aktivera den i Inställningar › Integritet och säkerhet › Kalendrar."
          }
        }

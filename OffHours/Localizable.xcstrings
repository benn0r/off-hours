    "Comma separated, not case sensitive. If a title matches both, it counts as on call." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommasepareret, uden forskel på store og små bogstaver. Matcher en titel begge, tæller den som vagt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Kommas getrennt, Groß- und Kleinschreibung egal. Passt ein Titel zu beidem, zählt er als Bereitschaft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separadas por comas, sin distinguir mayúsculas. Si un título coincide con ambas, cuenta como guardia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilkuin eroteltuina, kirjainkoolla ei ole väliä. Jos otsikko sopii molempiin, se lasketaan päivystykseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparés par des virgules, sans tenir compte de la casse. Si un titre correspond aux deux, il compte comme astreinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate da virgole, senza distinzione tra maiuscole e minuscole. Se un titolo corrisponde a entrambe, conta come reperibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カンマ区切り、大文字と小文字は区別しません。両方に一致するタイトルはオンコールとして扱われます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommaseparert, skiller ikke mellom store og små bokstaver. Passer en tittel til begge, teller den som vakt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gescheiden door komma's, niet hoofdlettergevoelig. Past een titel bij beide, dan telt hij als piket."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdzielone przecinkami, bez rozróżniania wielkości liter. Jeśli tytuł pasuje do obu, liczy się jako dyżur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separadas por vírgulas, sem diferenciar maiúsculas. Se um título corresponder a ambas, conta como plantão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separadas por vírgulas, sem distinguir maiúsculas. Se um título corresponder a ambas, conta como prevenção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommaseparerade, skiftlägesokänsliga. Om en titel matchar båda räknas den som jour."
          }
        }
      }
    },

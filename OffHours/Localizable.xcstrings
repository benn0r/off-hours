            "value" : "Werk-apps geblokkeerd"
          }
        }
      }
    },
    "Work apps open for meetings outside work hours, including weekends, but not on days off or holidays. All-day, free and declined events are ignored." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps professionnelles s'ouvrent pour les réunions en dehors des horaires, y compris le week-end, mais pas pendant les congés ou les jours fériés. Les événements sur toute la journée, disponibles ou refusés sont ignorés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app di lavoro si aprono per le riunioni fuori orario, anche nel weekend, ma non nei giorni liberi o festivi. Gli eventi di tutto il giorno, liberi o rifiutati vengono ignorati."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps de trabajo se abren para reuniones fuera del horario, también los fines de semana, pero no en días libres ni festivos. Se ignoran los eventos de todo el día, libres o rechazados."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk-apps gaan open voor vergaderingen buiten werktijd, ook in het weekend, maar niet op vrije dagen of feestdagen. Hele-dag-, vrije en afgewezen afspraken worden genegeerd."
          }
        }
      }
    },

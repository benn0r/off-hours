    "Optional. Events whose title contains one of the keywords below become on-call shifts or days off." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Les événements dont le titre contient l'un des mots-clés ci-dessous deviennent des astreintes ou des congés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Gli eventi il cui titolo contiene una delle parole chiave qui sotto diventano turni di reperibilità o giorni liberi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Los eventos cuyo título contiene una de las palabras clave de abajo se convierten en guardias o días libres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Afspraken met een van de onderstaande trefwoorden in de titel worden piketdiensten of vrije dagen."
          }
        }
      }
    },
    "Optional. Every day with an event in this calendar counts as a day off, e.g. a public holidays calendar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Chaque jour avec un événement dans ce calendrier compte comme congé, p. ex. un calendrier des jours fériés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Ogni giorno con un evento in questo calendario conta come giorno libero, ad es. un calendario delle festività."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

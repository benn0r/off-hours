    "Overrides beat every schedule, including on-call and days off." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undtagelser går forud for alle planer, også vagter og fridage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausnahmen haben Vorrang vor jedem Plan, auch vor Bereitschaft und freien Tagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las excepciones prevalecen sobre cualquier horario, incluidas guardias y días libres."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poikkeukset ohittavat kaikki aikataulut, myös päivystykset ja vapaapäivät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exceptions priment sur tous les horaires, y compris les astreintes et les congés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le eccezioni hanno la precedenza su tutti gli orari, inclusi reperibilità e giorni liberi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例外はオンコールや休日を含むすべてのスケジュールより優先されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unntak går foran alle planer, også vakter og fridager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitzonderingen gaan voor elk schema, ook piketdiensten en vrije dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyjątki mają pierwszeństwo przed każdym harmonogramem, także dyżurami i dniami wolnymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exceções valem mais que qualquer horário, inclusive plantões e folgas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exceções prevalecem sobre qualquer horário, incluindo prevenção e folgas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undantag går före alla scheman, även jour och lediga dagar."
          }
        }
      }

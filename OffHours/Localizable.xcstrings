        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off-hours utilise Temps d'écran pour bloquer vos apps professionnelles. Rien ne quitte votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off-hours usa Tempo di utilizzo per bloccare le tue app di lavoro. Nulla lascia il tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

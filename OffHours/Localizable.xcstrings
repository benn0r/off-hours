    "Comma separated, not case sensitive. If a title matches both, it counts as on call." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparés par des virgules, sans tenir compte de la casse. Si un titre correspond aux deux, il compte comme astreinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate da virgole, senza distinzione tra maiuscole e minuscole. Se un titolo corrisponde a entrambe, conta come reperibilità."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separadas por comas, sin distinguir mayúsculas. Si un título coincide con ambas, cuenta como guardia."
          }

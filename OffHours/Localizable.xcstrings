    "Optional. Events whose title contains one of the keywords below become on-call shifts or days off." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrit. Begivenheder, hvis titel indeholder et af nøgleordene nedenfor, bliver til vagter eller fridage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Termine, deren Titel eines der Stichwörter unten enthält, werden zu Bereitschaften oder freien Tagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Los eventos cuyo título contiene una de las palabras clave de abajo se convierten en guardias o días libres."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valinnainen. Tapahtumista, joiden otsikossa on jokin alla olevista avainsanoista, tulee päivystyksiä tai vapaapäiviä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Les événements dont le titre contient l'un des mots-clés ci-dessous deviennent des astreintes ou des congés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Gli eventi il cui titolo contiene una delle parole chiave qui sotto diventano turni di reperibilità o giorni liberi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意。タイトルに下のキーワードを含む予定は、オンコールまたは休日になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfritt. Hendelser der tittelen inneholder et av nøkkelordene nedenfor, blir vakter eller fridager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Afspraken met een van de onderstaande trefwoorden in de titel worden piketdiensten of vrije dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalnie. Wydarzenia, których tytuł zawiera jedno ze słów kluczowych poniżej, stają się dyżurami lub dniami wolnymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Eventos cujo título contém uma das palavras-chave abaixo viram plantões ou folgas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Os eventos cujo título contém uma das palavras-chave abaixo passam a turnos de prevenção ou folgas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valfritt. Händelser vars titel innehåller något av nyckelorden nedan blir jourpass eller lediga dagar."
          }
        }
      }
    },
    "Optional. Every day with an event in this calendar counts as a day off, e.g. a public holidays calendar." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrit. Hver dag med en begivenhed i denne kalender tæller som fridag, f.eks. en helligdagskalender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Jeder Tag mit einem Termin in diesem Kalender gilt als freier Tag, z. B. ein Feiertagskalender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Cada día con un evento en este calendario cuenta como día libre, p. ej. un calendario de festivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valinnainen. Jokainen päivä, jolla tässä kalenterissa on tapahtuma, on vapaapäivä, esim. pyhäpäiväkalenteri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Chaque jour avec un événement dans ce calendrier compte comme congé, p. ex. un calendrier des jours fériés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Ogni giorno con un evento in questo calendario conta come giorno libero, ad es. un calendario delle festività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意。このカレンダーに予定がある日はすべて休日になります（例：祝日カレンダー）。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfritt. Hver dag med en hendelse i denne kalenderen teller som fridag, f.eks. en helligdagskalender."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optioneel. Elke dag met een afspraak in deze agenda telt als vrije dag, bijv. een feestdagenagenda."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalnie. Każdy dzień z wydarzeniem w tym kalendarzu liczy się jako dzień wolny, np. kalendarz świąt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Cada dia com um evento neste calendário conta como folga, ex.: um calendário de feriados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Cada dia com um evento neste calendário conta como folga, p. ex. um calendário de feriados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valfritt. Varje dag med en händelse i den här kalendern räknas som ledig dag, t.ex. en helgdagskalender."
          }
        }
      }
    },

        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off-hours sperrt deine Arbeits-Apps mit Bildschirmzeit. Nichts verlässt dein Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off-hours usa Tiempo de uso para bloquear tus apps de trabajo. Nada sale de tu dispositivo."

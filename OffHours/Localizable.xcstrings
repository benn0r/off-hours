    "End must be after start. This day is treated as blocked." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slut skal være efter start. Dagen regnes som spærret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ende muss nach dem Beginn liegen. Dieser Tag gilt als gesperrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El final debe ser posterior al inicio. Este día se considera bloqueado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopun on oltava alun jälkeen. Päivää käsitellään estettynä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fin doit être après le début. Ce jour est considéré comme bloqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fine deve essere dopo l'inizio. Questo giorno è considerato bloccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了は開始より後にしてください。この日はブロック扱いになります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutt må være etter start. Dagen regnes som sperret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het einde moet na het begin liggen. Deze dag geldt als geblokkeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koniec musi być po początku. Ten dzień jest traktowany jako zablokowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fim precisa ser depois do início. Este dia é considerado bloqueado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fim tem de ser depois do início. Este dia é considerado bloqueado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slutet måste vara efter början. Dagen räknas som spärrad."
          }
        }
      }

    "Work apps are available during these hours and blocked in the evening, early morning and on days that aren't workdays." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbejdsapps er tilgængelige i disse tidsrum og spærret om aftenen, tidligt om morgenen og på dage, der ikke er arbejdsdage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeits-Apps sind in diesen Zeiten verfügbar und abends, frühmorgens und an Tagen ohne Arbeit gesperrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps de trabajo están disponibles en este horario y bloqueadas por la noche, a primera hora de la mañana y los días no laborables."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työapit ovat käytettävissä näinä aikoina ja estettyinä iltaisin, aikaisin aamulla ja päivinä, jotka eivät ole työpäiviä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps professionnelles sont disponibles pendant ces horaires et bloquées le soir, tôt le matin et les jours non ouvrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app di lavoro sono disponibili in questi orari e bloccate la sera, la mattina presto e nei giorni non lavorativi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この時間帯は仕事用Appを使えます。夜、早朝、勤務日以外はブロックされます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobbappene er tilgjengelige i disse tidene og sperret om kvelden, tidlig om morgenen og på dager som ikke er arbeidsdager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk-apps zijn tijdens deze uren beschikbaar en geblokkeerd in de avond, vroeg in de ochtend en op dagen die geen werkdag zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje służbowe są dostępne w tych godzinach i zablokowane wieczorem, wcześnie rano oraz w dni, które nie są dniami roboczymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps de trabalho ficam disponíveis neste horário e bloqueados à noite, de manhã cedo e nos dias que não são úteis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As apps de trabalho estão disponíveis neste horário e bloqueadas à noite, de manhã cedo e nos dias que não são úteis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobbapparna är tillgängliga under de här tiderna och spärrade på kvällen, tidigt på morgonen och på dagar som inte är arbetsdagar."
          }
        }
      }
    },
    "Work apps are blocked all day on vacation days and holidays, unless you're on call." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbejdsapps er spærret hele dagen på ferie- og helligdage, medmindre du har vagt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An Ferien- und Feiertagen sind Arbeits-Apps den ganzen Tag gesperrt, außer du hast Bereitschaft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps de trabajo se bloquean todo el día en vacaciones y festivos, salvo si estás de guardia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työapit ovat estettyinä koko päivän loma- ja pyhäpäivinä, ellet ole päivystyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps professionnelles sont bloquées toute la journée pendant les vacances et les jours fériés, sauf en astreinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app di lavoro sono bloccate tutto il giorno nei giorni di vacanza e festivi, salvo reperibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休暇や祝日は、オンコール中を除き一日中仕事用Appがブロックされます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobbappene er sperret hele dagen på ferie- og helligdager, med mindre du har vakt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk-apps zijn de hele dag geblokkeerd op vakantie- en feestdagen, behalve als je piket hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W dni urlopu i święta aplikacje służbowe są zablokowane przez cały dzień, chyba że masz dyżur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps de trabalho ficam bloqueados o dia todo nas férias e feriados, a menos que você esteja de plantão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As apps de trabalho ficam bloqueadas o dia todo nas férias e feriados, exceto se estiver de prevenção."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobbapparna är spärrade hela dagen på semester och helgdagar, utom när du har jour."
          }
        }
      }
    },

    "While on call, work apps stay available, even in the evening, on weekends and on days off." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under vagt er arbejdsapps tilgængelige, også om aftenen, i weekenden og på fridage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Bereitschaft bleiben Arbeits-Apps verfügbar, auch abends, am Wochenende und an freien Tagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante una guardia, las apps de trabajo siguen disponibles, incluso por la noche, los fines de semana y los días libres."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivystyksen aikana työapit pysyvät käytettävissä myös iltaisin, viikonloppuisin ja vapaapäivinä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant une astreinte, les apps professionnelles restent disponibles, même le soir, le week-end et les jours de congé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la reperibilità, le app di lavoro restano disponibili, anche la sera, nel weekend e nei giorni liberi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンコール中は、夜や週末、休日でも仕事用Appを使えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under vakt er jobbappene tilgjengelige, også om kvelden, i helgen og på fridager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens piket blijven werk-apps beschikbaar, ook 's avonds, in het weekend en op vrije dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas dyżuru aplikacje służbowe pozostają dostępne, także wieczorem, w weekendy i w dni wolne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante o plantão, os apps de trabalho continuam disponíveis, mesmo à noite, nos fins de semana e nas folgas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a prevenção, as apps de trabalho continuam disponíveis, mesmo à noite, ao fim de semana e nas folgas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under jour är jobbapparna tillgängliga, även på kvällar, helger och lediga dagar."
          }
        }
      }
    },

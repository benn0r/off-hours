    "Overrides beat every schedule, including on-call and days off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausnahmen haben Vorrang vor jedem Plan, auch vor Bereitschaft und freien Tagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las excepciones prevalecen sobre cualquier horario, incluidas guardias y días libres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exceptions priment sur tous les horaires, y compris les astreintes et les congés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le eccezioni hanno la precedenza su tutti gli orari, inclusi reperibilità e giorni liberi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitzonderingen gaan voor elk schema, ook piketdiensten en vrije dagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exceções valem mais que qualquer horário, inclusive plantões e folgas."
          }
        },
        "pt-PT" : {

            "state" : "translated",
            "value" : "App di lavoro"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk-apps"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps de trabalho"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps de trabalho"
          }
        }
      }
    },
    "Work apps are available during these hours and blocked in the evening, early morning and on days that aren't workdays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeits-Apps sind in diesen Zeiten verfügbar und abends, frühmorgens und an Tagen ohne Arbeit gesperrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps de trabajo están disponibles en este horario y bloqueadas por la noche, a primera hora de la mañana y los días no laborables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps professionnelles sont disponibles pendant ces horaires et bloquées le soir, tôt le matin et les jours non ouvrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app di lavoro sono disponibili in questi orari e bloccate la sera, la mattina presto e nei giorni non lavorativi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk-apps zijn tijdens deze uren beschikbaar en geblokkeerd in de avond, vroeg in de ochtend en op dagen die geen werkdag zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps de trabalho ficam disponíveis neste horário e bloqueados à noite, de manhã cedo e nos dias que não são úteis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As apps de trabalho estão disponíveis neste horário e bloqueadas à noite, de manhã cedo e nos dias que não são úteis."
          }
        }
      }
    },
    "Work apps are blocked all day on vacation days and holidays, unless you're on call." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An Ferien- und Feiertagen sind Arbeits-Apps den ganzen Tag gesperrt, außer du hast Bereitschaft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps de trabajo se bloquean todo el día en vacaciones y festivos, salvo si estás de guardia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps professionnelles sont bloquées toute la journée pendant les vacances et les jours fériés, sauf en astreinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app di lavoro sono bloccate tutto il giorno nei giorni di vacanza e festivi, salvo reperibilità."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk-apps zijn de hele dag geblokkeerd op vakantie- en feestdagen, behalve als je piket hebt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps de trabalho ficam bloqueados o dia todo nas férias e feriados, a menos que você esteja de plantão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As apps de trabalho ficam bloqueadas o dia todo nas férias e feriados, exceto se estiver de prevenção."
          }
        }
      }
    },
